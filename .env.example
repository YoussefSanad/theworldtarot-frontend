# Copy to `.env.local` and fill in. Every variable here is inlined into the
# bundle at build time, so each environment is a separate build and a wrong
# value ships to every visitor's browser — there is no server later to correct
# it. See DEPLOYMENT.md.
#
# The `NEXT_PUBLIC_` prefix is what puts a variable in the bundle at all. Without
# it the value reads as configured in every dashboard and is `undefined` in every
# browser.


# Where the backend lives.
#
# **Must be a subdomain of `theworldtarot.com`.** Not the Laravel Cloud platform
# URL, not a `pages.dev`, not a `workers.dev`. Session and `XSRF-TOKEN` cookies
# are issued for `.theworldtarot.com`, so from any other registrable domain the
# browser treats them as third party, Safari discards them, and **every write is
# refused while every unauthenticated read keeps working** — the site looks
# healthy right up to checkout. `docs/adr/0001-one-registrable-domain.md` has the
# whole argument, including the two other things tied to this hostname (Sanctum's
# stateful-domain list, and Stripe's payment method domains).
#
# This has been got wrong twice: corrected in #32, and found wrong again on
# 4 September 2026. Both times the value was the platform URL, because that is
# what a Laravel Cloud dashboard hands you.
#
#   staging      https://staging-api.theworldtarot.com
#   production   https://api.theworldtarot.com
NEXT_PUBLIC_API_BASE_URL=https://staging-api.theworldtarot.com


# Where this site itself lives — a different host from the API above.
#
# Canonicals, Open Graph URLs and the sitemap all have to be absolute, and a
# static export has no request to infer its own origin from, so it is
# configuration like everything else here. Nothing else in the app needs it:
# internal links are relative and every fetch goes to the API.
#
# Unset in development it falls back to `http://localhost:3000`, so a fresh clone
# runs. **Unset in a production build it throws**, rather than quietly telling
# search engines that the authoritative URL for every page is on a machine they
# cannot reach. A trailing slash is fine and is stripped.
#
#   staging      https://staging.theworldtarot.com
#   production   https://theworldtarot.com
NEXT_PUBLIC_SITE_URL=https://staging.theworldtarot.com


# What the wallet button mounts from. Publishable, not secret: it ships in the
# bundle by design and identifies the account rather than authorising anything.
# The secret key is the backend's and never appears in this repository.
#
# The build refuses a mismatch in either direction — a `pk_live_` key against a
# staging API quotes real money against test-priced orders, and a `pk_test_` key
# against anything else takes an authorization that can never be captured. Any
# host not beginning with `staging` is treated as production.
#
#   staging      pk_test_...
#   production   pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me


# Set to 1 to build against a local backend deliberately. Exempts the build from
# every deployability guard above rather than a subset — the loopback check, the
# registrable-domain check, and the Stripe key/environment match.
#
# Leave unset for anything that will be deployed.
# ALLOW_LOCAL_API_BUILD=1
